{
  "name": "vs-ai-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered voice assistant for VS Web Studio",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check:openai": "tsx src/scripts/check-openai.ts",
    "build": "tsc -p tsconfig.json && tsc -p netlify/tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p netlify/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.14.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
